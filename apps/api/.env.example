# Enable Banking application created in the Control Panel.
ENABLE_BANKING_APP_ID=
# Store the private key outside Git; this path is relative to apps/api.
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enablebanking-private.key
ENABLE_BANKING_API_URL=https://api.enablebanking.com
# Set this to the exact public HTTPS callback registered with Enable Banking.
ENABLE_BANKING_REDIRECT_URL=

# Use the pooled Neon connection URL for the running API.
DATABASE_URL=

# The backend binds to loopback by default for this single-user app.
HOST=127.0.0.1
PORT=3000

# Generate a private random token (at least 32 bytes); required for every route except /banking/callback.
FINAPP_API_TOKEN=

# Mock fixtures are available only when both are explicitly enabled in staging.
# Keep BANKING_MOCK_ENABLED=false in production and use an isolated staging database.
FINAPP_ENV=local
BANKING_MOCK_ENABLED=false
